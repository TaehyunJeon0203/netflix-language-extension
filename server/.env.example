DEEPL_API_KEY=your_deepl_api_key
# Use https://api.deepl.com/v2/translate for a DeepL Pro account.
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
PORT=3000
# Comma-separated origins. Leave unset to allow all origins.
CORS_ORIGINS=http://localhost:5173,chrome-extension://your-extension-id
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
DEEPL_TIMEOUT_MS=10000
