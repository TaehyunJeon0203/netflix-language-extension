{
  "manifest_version": 3,
  "name": "Netflix Subtitle Learner",
  "version": "0.1.0",
  "description": "Shows Korean translations and key words when Netflix is paused.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Netflix Subtitle Learner settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
