{
  "manifest_version": 3,
  "name": "Netflix Subtitle Learner",
  "version": "0.2.0",
  "description": "Shows Netflix English and Korean subtitles with word definitions when paused.",
  "permissions": [],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Netflix Subtitle Learner settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
